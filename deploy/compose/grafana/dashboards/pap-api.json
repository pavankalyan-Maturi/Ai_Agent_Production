{
  "uid": "pap-api",
  "title": "pap / API",
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(pap_http_requests_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(pap_http_request_duration_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "5xx ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pap_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(pap_http_requests_total[5m])), 1e-9)",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Spans accepted by collector",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(otelcol_receiver_accepted_spans_total[1m])",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    }
  ]
}