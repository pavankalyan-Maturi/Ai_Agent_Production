# vLLM launch config (ADR 013). Sourced by serving/serve.sh on the rented GPU box.
# Image tag pinned to the SPEC pin; check `vllm serve --help` on the box if a flag is rejected.
VLLM_IMAGE=vllm/vllm-openai:v0.34.0
MODEL=meta-llama/Llama-3.1-8B-Instruct
# Stable id for LiteLLM (gateway/litellm.yaml: hosted_vllm/local-llm), independent of MODEL.
SERVED_NAME=local-llm
# EAGLE-3 draft head for Llama-3.1-8B-Instruct. UNVERIFIED against vLLM 0.34 until P7.3 runs.
EAGLE3_DRAFT=yuhuili/EAGLE3-LLaMA3.1-Instruct-8B
NUM_SPEC_TOKENS=3
MAX_MODEL_LEN=8192
GPU_MEM_UTIL=0.90
MAX_NUM_SEQS=64
PORT=8000
